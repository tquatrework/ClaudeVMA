# .env.test — local PostgreSQL fallback for e2e tests
# Used when USE_LOCAL_DB=true or when Testcontainers cannot reach the Docker socket.
# TODO: remove when Testcontainers has Docker permissions

USE_LOCAL_DB=true

TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=profile_test
TEST_DB_USER=visiomath
TEST_DB_PASSWORD=visiomath_secret
