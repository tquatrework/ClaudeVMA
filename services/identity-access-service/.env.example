NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_access

# JWT — changer en production
JWT_SECRET=change-me-in-production-super-secret
JWT_EXPIRES_IN=1h

# Secret partagé entre identity-access-service et les services appelants (orchestration-service)
# pour sécuriser POST /internal/create-account
# Laisser vide pour désactiver la vérification (dev uniquement — déconseillé)
INTERNAL_SECRET=change-me-internal-secret
