# ── communication-service — environment variables ──────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL
DATABASE_URL=postgresql://visiomath:visiomath_secret@localhost:5432/visiomath_communication

# JWT (must match identity-access-service)
JWT_SECRET=change_me_in_production

# Internal API secret (shared with orchestration-service)
INTERNAL_SECRET=change_me_in_production

# Application
PORT=3000
NODE_ENV=development
