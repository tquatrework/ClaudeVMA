NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://visiomath:visiomath_secret@postgres:5432/visiomath_identity_access

# JWT — changer en production
JWT_SECRET=change-me-in-production-super-secret
JWT_EXPIRES_IN=1h

# Secret partagé entre identity-access-service et les services appelants (orchestration-service)
# pour sécuriser POST /internal/create-account
# Laisser vide pour désactiver la vérification (dev uniquement — déconseillé)
INTERNAL_SECRET=change-me-internal-secret

# ─── SMTP (Infomaniak) ─────────────────────────────────────────────────────────
# Ne jamais exposer ces valeurs côté client/front
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@visioprof.fr
SMTP_PASSWORD=<secret>

# ─── Expéditeur ───────────────────────────────────────────────────────────────
MAIL_FROM_NAME=VisioProf
MAIL_FROM_EMAIL=contact@visioprof.fr

# ─── URLs de la plateforme ────────────────────────────────────────────────────
# URL de base du front (pour les liens dans les emails)
FRONT_BASE_URL=https://visioprof.fr
# URL de base de l'API (pour les liens directs vers l'API si nécessaire)
API_BASE_URL=https://api.visioprof.fr

# ─── TTL des tokens email (en minutes) ───────────────────────────────────────
# Token de vérification d'adresse email après inscription
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# Token de récupération d'identifiant
RECOVER_IDENTIFIER_TOKEN_TTL_MINUTES=60

# Token de réinitialisation de mot de passe
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
