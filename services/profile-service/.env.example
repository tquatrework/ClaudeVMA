DATABASE_URL=postgresql://visiomath:visiomath_secret@postgres:5432/visiomath_profile
JWT_SECRET=change_me_with_a_long_random_string_in_production
NODE_ENV=development
PORT=3000

# --- Backfill script (scripts/backfill-profiles.ts) ---
# URL de base de identity-access-service (pour récupérer la liste des comptes)
IDENTITY_SERVICE_URL=http://localhost:3001
# URL de base de profile-service lui-même (peut différer en cas de proxy)
PROFILE_SERVICE_URL=http://localhost:3000
# Clé partagée pour les routes /internal/* (doit correspondre à INTERNAL_SECRET du service)
INTERNAL_SECRET=change_me_with_a_shared_internal_secret